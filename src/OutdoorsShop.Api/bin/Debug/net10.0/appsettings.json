{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=OutdoorsShopDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_SECRET_FROM_KEYVAULT",
    "Issuer": "OutdoorsShop.Api",
    "Audience": "OutdoorsShop.Web",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AzureStorage": {
    "ConnectionString": "REPLACE_WITH_STORAGE_CONNECTION",
    "ProductImagesContainer": "product-images",
    "ReceiptsContainer": "order-receipts",
    "ReportsContainer": "reports"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:5173" ]
}
